---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo_fekete.png';

interface Props {
  email: string;
  phone: string;
}

const { email, phone } = Astro.props;
---

<header class="header">
  <div class="top-bar">
    <div class="top-bar-container">
      <div class="contact-links">
        <a href={`https://mail.google.com/mail/?view=cm&to=${email}`} target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          <span class="contact-text">{email}</span>
        </a>
        <span class="separator">|</span>
        <a href={`tel:${phone.replace(/\s/g, '')}`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
          <span class="contact-text">{phone}</span>
        </a>
        <span class="separator">|</span>
        <a href="https://www.facebook.com/mosolyakutyanakmosolyagazdinak" target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          <span class="contact-text">Facebook</span>
        </a>
      </div>
    </div>
  </div>

  <div class="main-header">
    <div class="header-container">
      <a href="/" class="logo">
        <Image src={logo} alt="DOGSMILE" width={240} height={100} />
      </a>

      <nav class="nav">
        <a href="/" class="nav-link">Nyitólap</a>
        <div class="nav-dropdown">
          <a href="/#kurzusok" class="nav-link">Szolgáltatások <span class="arrow arrow-large">▾</span></a>
          <div class="dropdown-menu">
            <div class="dropdown-submenu">
              <a href="#" class="dropdown-submenu-trigger">Alap kurzus <span class="arrow arrow-large">▸</span></a>
              <div class="dropdown-submenu-menu">
                <a href="/kurzusok/alap">Egyéni</a>
                <a href="/kurzusok/csoportos-alap">Csoportos</a>
              </div>
            </div>
            <a href="/kurzusok/halado">Haladó kurzus</a>
            <a href="/kurzusok/trukk">Trükkmester</a>
            <a href="/kurzusok/happy-brain">Happy Brain</a>
          </div>
        </div>
        <a href="/buszkeseg" class="nav-link">Büszkeségfal</a>
        <a href="/rolam" class="nav-link">Rólam</a>
        <a href="/kapcsolat" class="nav-link">Kapcsolat</a>
      </nav>

      <button class="mobile-menu-btn" aria-label="Menü megnyitása" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div class="mobile-menu-overlay" aria-hidden="true"></div>

  <!-- Mobile Menu -->
  <nav class="mobile-menu" aria-hidden="true">
    <div class="mobile-menu-header">
      <span class="mobile-menu-title">Menü</span>
      <button class="mobile-menu-close" aria-label="Menü bezárása">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </button>
    </div>
    <div class="mobile-menu-content">
      <a href="/" class="mobile-nav-link">Nyitólap</a>

      <div class="mobile-nav-group">
        <button class="mobile-nav-toggle">
          Szolgáltatások
          <svg class="toggle-arrow" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/>
          </svg>
        </button>
        <div class="mobile-submenu">
          <div class="mobile-nav-subgroup">
            <button class="mobile-nav-subtoggle">
              Alap kurzus
              <svg class="toggle-arrow" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/>
              </svg>
            </button>
            <div class="mobile-sub-submenu">
              <a href="/kurzusok/alap">Egyéni</a>
              <a href="/kurzusok/csoportos-alap">Csoportos</a>
            </div>
          </div>
          <a href="/kurzusok/halado">Haladó kurzus</a>
          <a href="/kurzusok/trukk">Trükkmester</a>
          <a href="/kurzusok/happy-brain">Happy Brain</a>
        </div>
      </div>

      <a href="/buszkeseg" class="mobile-nav-link">Büszkeségfal</a>
      <a href="/rolam" class="mobile-nav-link">Rólam</a>
      <a href="/kapcsolat" class="mobile-nav-link">Kapcsolat</a>

      <a href="/jelentkezes" class="mobile-cta">Jelentkezem &raquo;</a>
    </div>
  </nav>
</header>

<script>
  function initMobileMenu() {
    const menuBtn = document.querySelector('.mobile-menu-btn');
    const closeBtn = document.querySelector('.mobile-menu-close');
    const overlay = document.querySelector('.mobile-menu-overlay');
    const mobileMenu = document.querySelector('.mobile-menu');
    const toggles = document.querySelectorAll('.mobile-nav-toggle');

    function openMenu() {
      mobileMenu?.classList.add('is-open');
      overlay?.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      menuBtn?.setAttribute('aria-expanded', 'true');
    }

    function closeMenu(instant = false) {
      if (instant) {
        // Instantly close without animation for navigation
        mobileMenu?.classList.add('no-transition');
        overlay?.classList.add('no-transition');
      }
      mobileMenu?.classList.remove('is-open');
      overlay?.classList.remove('is-open');
      document.body.style.overflow = '';
      menuBtn?.setAttribute('aria-expanded', 'false');

      if (instant) {
        // Re-enable transitions after a frame
        requestAnimationFrame(() => {
          mobileMenu?.classList.remove('no-transition');
          overlay?.classList.remove('no-transition');
        });
      }
    }

    menuBtn?.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', () => closeMenu(false));
    overlay?.addEventListener('click', () => closeMenu(false));

    // Close menu instantly on link click (for fast navigation)
    mobileMenu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => closeMenu(true));
    });

    // Submenu toggles
    toggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const group = toggle.parentElement;
        group?.classList.toggle('is-open');
      });
    });

    // Sub-submenu toggles
    const subtoggles = document.querySelectorAll('.mobile-nav-subtoggle');
    subtoggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const group = toggle.parentElement;
        group?.classList.toggle('is-open');
      });
    });

    // Close menu on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileMenu?.classList.contains('is-open')) {
        closeMenu(false);
      }
    });
  }

  // Initialize on page load
  initMobileMenu();

  // Re-initialize after Astro page transitions
  document.addEventListener('astro:after-swap', initMobileMenu);

  // Ensure menu is closed before page transition starts
  document.addEventListener('astro:before-preparation', () => {
    const mobileMenu = document.querySelector('.mobile-menu');
    const overlay = document.querySelector('.mobile-menu-overlay');
    mobileMenu?.classList.remove('is-open');
    overlay?.classList.remove('is-open');
    document.body.style.overflow = '';
  });
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
  }

  .top-bar {
    background: var(--color-header-bg);
    color: white;
    font-size: 0.85rem;
  }

  .top-bar-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.5rem 1.5rem;
  }

  .contact-links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: flex-start;
  }

  .contact-links a {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: white;
    opacity: 0.9;
    transition: opacity 0.2s;
  }

  .contact-links a:hover {
    opacity: 1;
  }

  .separator {
    color: white;
    opacity: 0.6;
  }

  .main-header {
    background: var(--color-header-light);
  }

  .header-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.25rem 1.5rem;
    padding-left: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    margin-left: 1rem;
  }

  .logo :global(img) {
    width: auto;
    height: 120px;
    margin: -10px 0;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-link {
    font-family: 'Cinzel', serif;
    color: var(--color-primary-dark);
    font-weight: 700;
    font-size: 16px;
    line-height: 28px;
    text-transform: uppercase;
    padding: 0.5rem 1rem;
    transition: opacity 0.2s;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-dropdown:hover .nav-link {
    opacity: 0.7;
  }

  .nav-dropdown {
    position: relative;
  }

  .arrow {
    font-size: 0.7em;
    margin-left: 0.15rem;
  }

  .arrow-large {
    font-size: 1.1em;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    background: white;
    min-width: 220px;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.2s;
  }

  .nav-dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-menu a {
    display: block;
    padding: 0.75rem 1rem;
    color: var(--color-text);
    font-weight: 500;
    text-transform: none;
    transition: background 0.2s;
  }

  .dropdown-menu a:hover {
    background: var(--color-secondary);
  }

  .dropdown-submenu {
    position: relative;
  }

  .dropdown-submenu-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    color: var(--color-text);
    font-weight: 500;
    text-transform: none;
    transition: background 0.2s;
    cursor: pointer;
  }

  .dropdown-submenu-trigger:hover {
    background: var(--color-secondary);
  }

  .dropdown-submenu-menu {
    position: absolute;
    left: 100%;
    top: 0;
    background: var(--color-primary);
    min-width: 180px;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-10px);
    transition: all 0.2s;
  }

  .dropdown-submenu-menu a {
    color: white;
  }

  .dropdown-submenu-menu a:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .dropdown-submenu:hover .dropdown-submenu-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }

  /* Mobile menu button */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
    min-width: 44px;
    min-height: 44px;
    z-index: 1001;
    flex-shrink: 0;
  }

  .mobile-menu-btn span {
    display: block;
    width: 24px;
    height: 3px;
    background: var(--color-primary);
    border-radius: 2px;
    transition: transform 0.3s, opacity 0.3s;
  }

  /* Mobile menu overlay - hidden by default */
  .mobile-menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1001;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s, visibility 0.3s;
  }

  .mobile-menu-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Mobile menu - hidden by default */
  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 300px;
    max-width: 85vw;
    background: white;
    z-index: 1002;
    transform: translateX(100%);
    visibility: hidden;
    transition: transform 0.3s ease, visibility 0.3s;
    display: flex;
    flex-direction: column;
  }

  .mobile-menu.is-open {
    transform: translateX(0);
    visibility: visible;
  }

  .mobile-menu.no-transition,
  .mobile-menu-overlay.no-transition {
    transition: none !important;
  }

  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-secondary);
    background: var(--color-primary);
    color: white;
  }

  .mobile-menu-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    text-transform: uppercase;
  }

  .mobile-menu-close {
    background: none;
    border: none;
    color: white;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-menu-content {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 0;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.875rem 1.25rem;
    color: var(--color-text);
    font-weight: 600;
    border-bottom: 1px solid var(--color-secondary);
    transition: background 0.2s;
  }

  .mobile-nav-link:hover {
    background: var(--color-secondary);
  }

  .mobile-nav-group {
    border-bottom: 1px solid var(--color-secondary);
  }

  .mobile-nav-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.875rem 1.25rem;
    background: none;
    border: none;
    color: var(--color-text);
    font-weight: 600;
    font-size: 1rem;
    font-family: inherit;
    cursor: pointer;
    text-align: left;
  }

  .mobile-nav-toggle:hover {
    background: var(--color-secondary);
  }

  .toggle-arrow {
    transition: transform 0.2s;
  }

  .mobile-nav-group.is-open .toggle-arrow {
    transform: rotate(180deg);
  }

  .mobile-submenu {
    display: none;
    background: var(--color-secondary);
  }

  .mobile-nav-group.is-open .mobile-submenu {
    display: block;
  }

  .mobile-submenu a {
    display: block;
    padding: 0.75rem 1.25rem 0.75rem 2rem;
    color: var(--color-text-light);
    font-weight: 500;
    font-size: 0.95rem;
    transition: background 0.2s, color 0.2s;
  }

  .mobile-submenu a:hover {
    background: rgba(0, 0, 0, 0.05);
    color: var(--color-primary);
  }

  .mobile-nav-subgroup {
  }

  .mobile-nav-subtoggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.75rem 1.25rem 0.75rem 2rem;
    background: none;
    border: none;
    color: var(--color-text-light);
    font-weight: 500;
    font-size: 0.95rem;
    font-family: inherit;
    cursor: pointer;
    text-align: left;
  }

  .mobile-nav-subtoggle:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  .mobile-nav-subgroup .toggle-arrow {
    transition: transform 0.2s;
  }

  .mobile-nav-subgroup.is-open .toggle-arrow {
    transform: rotate(180deg);
  }

  .mobile-sub-submenu {
    display: none;
    background: rgba(0, 0, 0, 0.03);
  }

  .mobile-nav-subgroup.is-open .mobile-sub-submenu {
    display: block;
  }

  .mobile-sub-submenu a {
    padding-left: 3rem;
  }

  .mobile-cta {
    display: block;
    margin: 1.5rem 1.25rem;
    padding: 1rem;
    background: var(--color-primary);
    color: white;
    text-align: center;
    font-weight: 600;
    border-radius: 8px;
    transition: background 0.2s;
  }

  .mobile-cta:hover {
    background: var(--color-primary-dark);
  }

  /* Responsive */
  @media (max-width: 968px) {
    .nav {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }
  }

  @media (max-width: 600px) {
    .top-bar-container {
      padding: 0.4rem 1rem;
    }

    .contact-text {
      display: none;
    }

    .contact-links {
      gap: 1rem;
    }

    .contact-links a {
      padding: 0.25rem;
    }

    .contact-links svg {
      width: 18px;
      height: 18px;
    }

    .separator {
      display: none;
    }

    .header-container {
      padding: 0.5rem 0.75rem;
    }

    .logo {
      margin-left: 0;
      flex-shrink: 1;
      min-width: 0;
      overflow: hidden;
    }

    .logo :global(img) {
      height: 60px;
      max-width: 100%;
    }
  }
</style>
