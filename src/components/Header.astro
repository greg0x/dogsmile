---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.jpg';

interface Props {
  email: string;
  phone: string;
  instagram: string;
}

const { email, phone, instagram } = Astro.props;
---

<header class="header">
  <div class="top-bar">
    <div class="top-bar-container">
      <div class="contact-links">
        <a href={`mailto:${email}`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          {email}
        </a>
        <a href={`tel:${phone.replace(/\s/g, '')}`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
          {phone}
        </a>
        <a href={instagram} target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          Instagram
        </a>
      </div>
    </div>
  </div>

  <div class="main-header">
    <div class="header-container">
      <a href="/" class="logo">
        <Image src={logo} alt="DOGSMILE" width={100} height={100} />
      </a>

      <nav class="nav">
        <a href="/">Nyitólap</a>
        <div class="nav-dropdown">
          <a href="#kurzusok">Alap kurzusok <span class="arrow">▾</span></a>
          <div class="dropdown-menu">
            <a href="/kurzusok/alap">Egyéni Alap kurzus</a>
            <a href="/kurzusok/csoportos-alap">Csoportos Alap kurzus</a>
            <a href="/kurzusok/csoportos-kolyok">Csoportos Kölyök kurzus</a>
          </div>
        </div>
        <div class="nav-dropdown">
          <a href="#tovabbtanulas">Továbbtanulás <span class="arrow">▾</span></a>
          <div class="dropdown-menu">
            <a href="/kurzusok/halado">Haladó kurzus</a>
            <a href="/kurzusok/trukk">Trükk mester</a>
          </div>
        </div>
        <a href="/buszkeseg">Büszkeség Fal</a>
        <a href="/rolam">Rólam</a>
        <a href="/kapcsolat">Kapcsolat</a>
      </nav>

      <button class="mobile-menu-btn" aria-label="Menü">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
  }

  .top-bar {
    background: var(--color-header-bg);
    color: white;
    font-size: 0.85rem;
  }

  .top-bar-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.5rem 1.5rem;
  }

  .contact-links {
    display: flex;
    gap: 1.5rem;
    justify-content: flex-start;
  }

  .contact-links a {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: white;
    opacity: 0.9;
    transition: opacity 0.2s;
  }

  .contact-links a:hover {
    opacity: 1;
  }

  .main-header {
    background: var(--color-primary);
  }

  .header-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .logo :global(img) {
    border-radius: 8px;
    width: 80px;
    height: auto;
  }

  .nav {
    display: flex;
    gap: 0.25rem;
  }

  .nav > a,
  .nav-dropdown > a {
    color: white;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    transition: background 0.2s;
  }

  .nav > a:hover,
  .nav-dropdown:hover > a {
    background: rgba(255, 255, 255, 0.1);
  }

  .nav-dropdown {
    position: relative;
  }

  .arrow {
    font-size: 0.7em;
    margin-left: 0.25rem;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    background: white;
    min-width: 220px;
    border-radius: 4px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.2s;
  }

  .nav-dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-menu a {
    display: block;
    padding: 0.75rem 1rem;
    color: var(--color-text);
    transition: background 0.2s;
  }

  .dropdown-menu a:hover {
    background: var(--color-secondary);
  }

  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .mobile-menu-btn span {
    display: block;
    width: 24px;
    height: 2px;
    background: white;
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }
  }
</style>
