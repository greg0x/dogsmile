---
import { Image } from 'astro:assets';
import logoFeher from '../assets/images/logo_fehér.png';

interface Props {
  email: string;
  phone: string;
  instagram: string;
}

const { email, phone, instagram } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="footer" id="kapcsolat">
  <div class="footer-container">
    <div class="footer-brand">
      <Image src={logoFeher} alt="DOGSMILE" width={180} height={75} class="footer-logo-img" />
    </div>

    <div class="footer-links">
      <h4>Kurzusok</h4>
      <nav>
        <a href="/kurzusok/alap">Alap kurzus</a>
        <a href="/kurzusok/halado">Haladó kurzus</a>
        <a href="/kurzusok/trukk">Trükkmester</a>
        <a href="#">Happy Brain</a>
      </nav>
    </div>

    <div class="footer-links">
      <h4>Oldalak</h4>
      <nav>
        <a href="/">Nyitólap</a>
        <a href="/buszkeseg">Büszkeség Fal</a>
        <a href="/rolam">Rólam</a>
        <a href="/kapcsolat">Kapcsolat</a>
      </nav>
    </div>

    <div class="footer-links">
      <nav class="footer-legal">
        <a href="/aszf">ÁSZF</a>
        <a href="/adatkezeles">Adatkezelési tájékoztató</a>
        <a href="/impresszum">Impresszum</a>
      </nav>
    </div>

    <div class="footer-contact">
      <h4>Kapcsolat</h4>
      <a href={`mailto:${email}`}>{email}</a>
      <a href={`tel:${phone.replace(/[^0-9+]/g, '')}`}>{phone}</a>
      <div class="social-links">
        <a href="https://www.facebook.com/mosolyakutyanakmosolyagazdinak" target="_blank" rel="noopener" aria-label="Facebook">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {currentYear} DOGSMILE. Minden jog fenntartva.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-primary);
    color: white;
    padding: 4rem 1.5rem 2rem;
    margin-top: auto;
  }

  .footer-container {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 0.8fr 1fr;
    gap: 3rem;
  }

  .footer-brand :global(.footer-logo-img) {
    width: auto;
    height: 150px;
  }

  .footer-brand p {
    margin-top: 0.5rem;
    opacity: 0.8;
    font-size: 0.875rem;
    max-width: 250px;
  }

  .footer h4 {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    opacity: 1;
    color: white;
  }

  .footer-links nav,
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer a {
    opacity: 0.9;
    transition: opacity 0.2s;
    font-size: 0.9rem;
  }

  .footer a:hover {
    opacity: 1;
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s;
  }

  .social-links a:hover {
    opacity: 0.8;
  }

  .footer-bottom {
    max-width: var(--max-width);
    margin: 3rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    text-align: center;
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .footer-legal {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  @media (max-width: 900px) {
    .footer-container {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer-container {
      grid-template-columns: 1fr;
    }
  }
</style>
