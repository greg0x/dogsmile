---
interface Props {
  email: string;
  phone: string;
  instagram: string;
}

const { email, phone, instagram } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="footer" id="kapcsolat">
  <div class="footer-container">
    <div class="footer-brand">
      <span class="footer-logo">DOGSMILE</span>
      <p>Pozitív megerősítésen alapuló kutyakiképzés</p>
    </div>

    <div class="footer-links">
      <h4>Oldalak</h4>
      <nav>
        <a href="#kurzusok">Kurzusok</a>
        <a href="#modszer">Módszer</a>
        <a href="#velemenyek">Vélemények</a>
      </nav>
    </div>

    <div class="footer-contact">
      <h4>Kapcsolat</h4>
      <a href={`mailto:${email}`}>{email}</a>
      <a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a>
      <a href={instagram} target="_blank" rel="noopener">Instagram</a>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {currentYear} DOGSMILE. Minden jog fenntartva.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-primary);
    color: white;
    padding: 4rem 1.5rem 2rem;
    margin-top: 4rem;
  }

  .footer-container {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 3rem;
  }

  .footer-logo {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .footer-brand p {
    margin-top: 0.5rem;
    opacity: 0.8;
    font-size: 0.875rem;
  }

  .footer h4 {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    opacity: 0.8;
  }

  .footer-links nav,
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer a {
    opacity: 0.9;
    transition: opacity 0.2s;
  }

  .footer a:hover {
    opacity: 1;
  }

  .footer-bottom {
    max-width: var(--max-width);
    margin: 3rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    text-align: center;
    font-size: 0.875rem;
    opacity: 0.7;
  }
</style>
