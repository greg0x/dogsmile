---
interface Props {
  name: string;
  quote: string;
  image?: string;
}

const { name, quote, image } = Astro.props;
---

<blockquote class="testimonial">
  <p class="testimonial-quote">"{quote}"</p>
  <footer class="testimonial-footer">
    <cite class="testimonial-name">{name}</cite>
  </footer>
</blockquote>

<style>
  .testimonial {
    background: var(--color-secondary);
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  .testimonial-quote {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-primary);
    margin-bottom: 1.5rem;
    font-style: normal;
  }

  .testimonial-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .testimonial-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    overflow: hidden;
  }

  .testimonial-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonial-name {
    font-style: normal;
    font-weight: 600;
    color: var(--color-text);
  }
</style>
