---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle: string;
  description: string;
  image: ImageMetadata;
  href?: string;
  reversed?: boolean;
  highlighted?: boolean;
}

const { title, subtitle, description, image, href = "#", reversed = false, highlighted = false } = Astro.props;
---

<article class="course-card">
  <a href={href} class="course-link-wrapper" style={reversed ? 'flex-direction: row-reverse;' : ''}>
    <div class="course-image">
      <Image
        src={image}
        alt={title}
        width={600}
        height={400}
        loading="lazy"
      />
    </div>
    <div class="course-content">
      <span class="course-subtitle">{subtitle}</span>
      <h3 class="course-title">{title}</h3>
      <p class="course-description">{description}</p>
      <span class="course-link">Részletek &rarr;</span>
    </div>
  </a>
</article>

<style>
  .course-card {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .course-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
  }

  .course-link-wrapper {
    display: flex;
    flex-direction: row;
  }

  .course-link-wrapper.reversed {
    flex-direction: row-reverse;
  }

  .course-image {
    flex: 1;
    min-height: 280px;
    overflow: hidden;
  }

  .course-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .course-card:hover .course-image :global(img) {
    transform: scale(1.05);
  }

  .course-content {
    flex: 1;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .course-subtitle {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    font-weight: 600;
  }

  .course-title {
    font-size: 1.5rem;
    color: var(--color-primary);
    margin: 0.5rem 0;
  }

  .course-description {
    color: var(--color-text-light);
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .course-link {
    display: inline-block;
    background: var(--color-primary);
    color: white;
    padding: 0.4rem 1rem;
    font-size: 0.85rem;
    align-self: flex-start;
    border-radius: 6px;
    font-weight: 600;
    transition: background 0.2s, transform 0.2s;
  }

  .course-card:hover .course-link {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .course-link-wrapper,
    .course-link-wrapper.reversed {
      flex-direction: column;
    }

    .course-image {
      min-height: 200px;
    }
  }
</style>
