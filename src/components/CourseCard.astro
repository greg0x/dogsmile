---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle: string;
  description: string;
  image: ImageMetadata;
  href?: string;
}

const { title, subtitle, description, image, href = "#" } = Astro.props;
---

<article class="course-card">
  <a href={href} class="course-link-wrapper">
    <div class="course-image">
      <Image
        src={image}
        alt={title}
        width={400}
        height={250}
        loading="lazy"
      />
    </div>
    <div class="course-content">
      <span class="course-subtitle">{subtitle}</span>
      <h3 class="course-title">{title}</h3>
      <p class="course-description">{description}</p>
      <span class="course-link">Részletek &rarr;</span>
    </div>
  </a>
</article>

<style>
  .course-card {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .course-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
  }

  .course-link-wrapper {
    display: block;
  }

  .course-image {
    aspect-ratio: 16/10;
    overflow: hidden;
  }

  .course-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .course-card:hover .course-image :global(img) {
    transform: scale(1.05);
  }

  .course-content {
    padding: 1.5rem;
  }

  .course-subtitle {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    font-weight: 600;
  }

  .course-title {
    font-size: 1.5rem;
    color: var(--color-primary);
    margin: 0.5rem 0;
  }

  .course-description {
    color: var(--color-text-light);
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .course-link {
    color: var(--color-primary);
    font-weight: 600;
    transition: color 0.2s;
  }

  .course-card:hover .course-link {
    color: var(--color-accent);
  }
</style>
