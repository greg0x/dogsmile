---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/herohoz.jpg';
---

<section class="hero-wrapper">
  <div class="hero">
  <div class="hero-content">
    <h1>Legyetek még jobb társak a kutyáddal!</h1>
    <p>Kényszerítés, büntetés és bántalmazás mentes kutyaoktatás Szegeden és környékén</p>
    <a href="#kurzusok" class="cta-button">Kurzusok megtekintése</a>
  </div>
  <div class="hero-image">
    <Image
      src={heroImage}
      alt="Boldog kutya gazdájával"
      width={1400}
      height={930}
      quality={90}
      loading="eager"
    />
  </div>
  </div>
</section>

<style>
  .hero-wrapper {
    background: #EAF3FC;
  }

  .hero {
    min-height: auto;
    display: flex;
    align-items: center;
    padding: 6rem 1.5rem 1.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
    gap: 3rem;
  }

  .hero-content {
    flex: 1;
    margin-top: 4.8rem;
  }

  .hero h1 {
    font-family: 'Cinzel', serif;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.2;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .hero p {
    font-size: 1.15rem;
    color: var(--color-text-light);
    margin-bottom: 2rem;
    max-width: 500px;
  }

  .cta-button {
    display: inline-block;
    background: var(--color-primary);
    color: white;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    transition: background 0.2s, transform 0.2s;
  }

  .cta-button:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
  }

  .hero-image {
    flex: 1;
  }

  .hero-image :global(img) {
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    width: 100%;
    height: auto;
    margin-top: 4.8rem;
  }

  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      min-height: auto;
      padding-top: 6rem;
    }

    .hero-content {
      text-align: center;
    }

    .hero p {
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
