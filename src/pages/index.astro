---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PricingTable from '../components/PricingTable.astro';
import CourseCard from '../components/CourseCard.astro';
import Testimonial from '../components/Testimonial.astro';
import Footer from '../components/Footer.astro';

// Import course images for optimization
import alapImage from '../assets/images/courses/alap.jpg';
import haladoImage from '../assets/images/courses/halado.png';
import trukkImage from '../assets/images/courses/trukk.jpg';
import methodologyImage from '../assets/images/methodology.jpg';

// Map course IDs to imported images
const courseImages: Record<string, ImageMetadata> = {
  'alap': alapImage,
  'halado': haladoImage,
  'trukk': trukkImage,
  'csoportos-alap': alapImage,
  'csoportos-kolyok': alapImage,
};

const allCourses = await getCollection('courses');
const testimonials = await getCollection('testimonials');
const siteInfo = await getEntry('site-info', 'main');
const pricingData = await getEntry('pricing', 'tiers');

// Sort by order and take first 3 for homepage
const sortedCourses = allCourses.sort((a, b) => a.data.order - b.data.order);
const featuredCourses = sortedCourses.slice(0, 3);
const sortedTestimonials = testimonials.sort((a, b) => a.data.order - b.data.order);
const pricingTiers = pricingData.data.sort((a, b) => a.order - b.order);
---

<Layout title="Kutyakiképzés pozitív megerősítéssel">
  <Header
    email={siteInfo.data.email}
    phone={siteInfo.data.phone}
    instagram={siteInfo.data.instagram}
  />

  <main>
    <Hero />

    <PricingTable tiers={pricingTiers} />

    <section class="courses" id="kurzusok">
      <div class="container">
        <h2 class="section-title">Kurzusok, amikben részt vehetsz</h2>
        <p class="section-subtitle">Válaszd ki a számodra megfelelő programot</p>

        <div class="courses-grid">
          {featuredCourses.map((course) => (
            <CourseCard
              title={course.data.title}
              subtitle={course.data.subtitle}
              description={course.data.description}
              image={courseImages[course.id]}
              href={`/kurzusok/${course.id}`}
            />
          ))}
        </div>

        <div class="all-courses-link">
          <p>További kurzusaink:
            {sortedCourses.slice(3).map((course, i) => (
              <>
                <a href={`/kurzusok/${course.id}`}>{course.data.title}</a>
                {i < sortedCourses.slice(3).length - 1 && ', '}
              </>
            ))}
          </p>
        </div>
      </div>
    </section>

    <section class="methodology" id="modszer">
      <div class="container">
        <h2 class="section-title">{siteInfo.data.methodology.title}</h2>
        <div class="methodology-content">
          <div class="methodology-text">
            <p>{siteInfo.data.methodology.content}</p>
            <a href="/rolam" class="learn-more">Tudj meg többet rólam &rarr;</a>
          </div>
          <div class="methodology-image">
            <Image
              src={methodologyImage}
              alt="Láthatatlan Póráz módszer"
              width={500}
              height={375}
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="testimonials" id="velemenyek">
      <div class="container">
        <h2 class="section-title">Vélemények a kurzusokról</h2>
        <p class="section-subtitle">Gazdik és kutyáik sikertörténetei</p>

        <div class="testimonials-grid">
          {sortedTestimonials.map((testimonial) => (
            <Testimonial
              name={testimonial.data.name}
              quote={testimonial.data.quote}
              image={testimonial.data.image}
            />
          ))}
        </div>

        <div class="pride-wall-link">
          <a href="/buszkeseg">Nézd meg a Büszkeség Falat &rarr;</a>
        </div>
      </div>
    </section>
  </main>

  <Footer
    email={siteInfo.data.email}
    phone={siteInfo.data.phone}
    instagram={siteInfo.data.instagram}
  />
</Layout>

<style>
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  section {
    padding: 5rem 0;
  }

  .section-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--color-primary);
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-light);
    margin-bottom: 3rem;
  }

  /* Courses Section */
  .courses {
    background: var(--color-secondary);
  }

  .courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .all-courses-link {
    text-align: center;
    margin-top: 2rem;
    color: var(--color-text-light);
  }

  .all-courses-link a {
    color: var(--color-primary);
    font-weight: 500;
  }

  .all-courses-link a:hover {
    text-decoration: underline;
  }

  /* Methodology Section */
  .methodology-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .methodology-text p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
  }

  .learn-more {
    color: var(--color-primary);
    font-weight: 600;
    transition: color 0.2s;
  }

  .learn-more:hover {
    color: var(--color-accent);
  }

  .methodology-image :global(img) {
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    width: 100%;
    height: auto;
  }

  /* Testimonials Section */
  .testimonials {
    background: var(--color-secondary);
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .pride-wall-link {
    text-align: center;
    margin-top: 2rem;
  }

  .pride-wall-link a {
    color: var(--color-primary);
    font-weight: 600;
    transition: color 0.2s;
  }

  .pride-wall-link a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .methodology-content {
      grid-template-columns: 1fr;
    }
  }
</style>
