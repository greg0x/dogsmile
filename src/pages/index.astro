---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PricingTable from '../components/PricingTable.astro';
import CourseCard from '../components/CourseCard.astro';
import Testimonial from '../components/Testimonial.astro';
import Footer from '../components/Footer.astro';

// Import course images for optimization
import alapImage from '../assets/images/courses/alap.jpg';
import haladoImage from '../assets/images/courses/halado.png';
import trukkImage from '../assets/images/courses/trukk.jpg';
import happybrainImage from '../assets/images/happy_nyitóra.jpg';
import methodologyImage from '../assets/images/methodology.jpg';
import fokepImage from '../assets/images/főképnek.jpg';

// Map course IDs to imported images
const courseImages: Record<string, ImageMetadata> = {
  'alap': alapImage,
  'halado': haladoImage,
  'trukk': trukkImage,
  'csoportos-alap': alapImage,
  'csoportos-kolyok': alapImage,
};

const allCourses = await getCollection('courses');
const testimonials = await getCollection('testimonials');
const siteInfo = await getEntry('site-info', 'main');
const pricingData = await getEntry('pricing', 'tiers');

// Sort by order and take first 3 for homepage
const sortedCourses = allCourses.sort((a, b) => a.data.order - b.data.order);
const featuredCourses = sortedCourses.slice(0, 3);
const sortedTestimonials = testimonials.sort((a, b) => a.data.order - b.data.order);
const pricingTiers = pricingData.data.sort((a, b) => a.order - b.order);
---

<Layout title="Kutyakiképzés pozitív megerősítéssel">
  <Header
    email={siteInfo.data.email}
    phone={siteInfo.data.phone}

  />

  <main>
    <Hero />

    <section class="courses" id="kurzusok">
      <div class="container">
        <h2 class="section-title">Kurzusok, amiken részt vehetsz</h2>

        <div class="courses-list">
          {featuredCourses.map((course, index) => (
            <CourseCard
              title={course.data.title}
              subtitle={course.data.subtitle}
              description={course.data.description}
              image={courseImages[course.id]}
              href={`/kurzusok/${course.id}`}
              reversed={index % 2 !== 0}
              highlighted={course.id === 'alap'}
            />
          ))}
          <CourseCard
            title="Happy Brain"
            subtitle="Szolgáltatás"
            description="Az alap kurzus után sem maradsz egyedül. Támogató lehetőségekkel segítem a megszerzett tudás fenntartását."
            image={happybrainImage}
            href="/kurzusok/happy-brain"
            reversed={featuredCourses.length % 2 !== 0}
          />
        </div>

      </div>
    </section>

    <section class="methodology" id="modszer">
      <div class="container">
        <h2 class="section-title">{siteInfo.data.methodology.title}</h2>
        <div class="methodology-content">
          <div class="methodology-text">
            <p>A tréning a <a href="https://lathatatlanporaz.hu/" target="_blank" rel="noopener noreferrer" class="methodology-link"><strong>Láthatatlan Póráz Módszer & Program</strong></a> tematikájára épül, mely teljes mértékben erőszakmentes. Csak pozitív megerősítéssel dolgozunk és kapcsolat fókuszú.</p>

            <p class="quote"><em>A "Láthatatlan póráz" program arról szól, hogy kutyánkat elsősorban szavainkkal, mozdulatainkkal tudjuk irányítani, ne a pórázt rángatva húzzuk, vonjuk őt, ne kelljen kiabálnunk vele. Ehhez elengedhetetlenül fontos, hogy tanuljunk kutyául, megértsük, a kutyánknak mi a fontos és elfogadjuk, hogy a változáshoz előbb változtatnunk kell.</em><br/>(Dömötör Júlia- a Láthatatlan Póráz Módszer alapítója)</p>

            <p>A tréning során egy kidolgozott, fix tematika szerint haladunk, emiatt a feladatok (pl: ül, fekszik, behívás, kapu kontroll) időben nem cserélhetők fel és nem is hagyhatók el. Minden feladat lépcsőzetesen van felépítve, megkönnyítve így a tanulást és a gyakorlást. Ahogy haladunk előre, úgy épül szépen az a bizonyos láthatatlan póráz, mely gyakorlatilag a gazdi-kutyus kölcsönös bizalma.</p>

            <p><strong>FONTOS!</strong> Ez a módszer nem tünetet kezel és nem egy dologra/problémára fókuszál, így az alkalmak során nem engedelmességet, hanem együttműködést tanítunk. Egy olyan keretet, amely működtetésével sokszor magától megoldódnak korábbi problémák anélkül, hogy kimondottan azzal foglalkoztunk volna.</p>

          </div>
          <div class="methodology-image">
            <Image
              src={methodologyImage}
              alt="Láthatatlan Póráz módszer"
              width={1500}
              height={1000}
              quality={90}
              loading="lazy"
            />
            <Image
              src={fokepImage}
              alt="DOGSMILE kutyaoktatás"
              width={1500}
              height={1000}
              quality={90}
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="testimonials" id="velemenyek">
      <div class="container">
        <h2 class="section-title">Vélemények a kurzusokról</h2>


        <div class="testimonials-grid">
          {sortedTestimonials.map((testimonial) => (
            <Testimonial
              name={testimonial.data.name}
              quote={testimonial.data.quote}
              image={testimonial.data.image}
            />
          ))}
        </div>

        <div class="pride-wall-link">
          <a href="/buszkeseg">Nézd meg a Büszkeség Falat &rarr;</a>
        </div>
      </div>
    </section>
  </main>

  <Footer
    email={siteInfo.data.email}
    phone={siteInfo.data.phone}

  />
</Layout>

<style>
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  section {
    padding: 5rem 0;
  }

  .section-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--color-primary);
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-light);
    margin-bottom: 3rem;
  }

  /* Courses Section */
  .courses {
    background: white;
  }

  .courses-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .all-courses-link {
    text-align: center;
    margin-top: 2rem;
    color: var(--color-text-light);
  }

  .all-courses-link a {
    color: var(--color-primary);
    font-weight: 500;
  }

  .all-courses-link a:hover {
    text-decoration: underline;
  }

  /* Methodology Section */
  .methodology-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .methodology {
    background: var(--color-secondary);
  }

  .methodology-text p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
    text-align: justify;
    text-align-last: left;
  }

  .methodology-text .quote {
    font-style: italic;
  }

  .methodology-link {
    color: var(--color-primary);
    text-decoration: none;
  }

  .methodology-link:hover {
    color: var(--color-primary-dark);
  }

  .learn-more {
    color: var(--color-primary);
    font-weight: 600;
    transition: color 0.2s;
  }

  .learn-more:hover {
    color: var(--color-accent);
  }

  .methodology-image {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .methodology-image :global(img) {
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    width: 100%;
    height: auto;
  }

  /* Testimonials Section */
  .testimonials {
    background: white;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .pride-wall-link {
    text-align: center;
    margin-top: 2rem;
  }

  .pride-wall-link a {
    color: var(--color-primary);
    font-weight: 600;
    transition: color 0.2s;
  }

  .pride-wall-link a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .methodology-content {
      grid-template-columns: 1fr;
    }
  }
</style>
