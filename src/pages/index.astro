---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PricingTable from '../components/PricingTable.astro';
import CourseCard from '../components/CourseCard.astro';
import Testimonial from '../components/Testimonial.astro';
import Footer from '../components/Footer.astro';

// Import course images for optimization
import alapImage from '../assets/images/courses/alap.jpg';
import haladoImage from '../assets/images/courses/halado.png';
import trukkImage from '../assets/images/courses/trukk.jpg';
import happybrainImage from '../assets/images/happy_nyitóra.jpg';
import methodologyImage from '../assets/images/methodology.jpg';
import fokepImage from '../assets/images/főképnek.jpg';

// Map course IDs to imported images
const courseImages: Record<string, ImageMetadata> = {
  'alap': alapImage,
  'halado': haladoImage,
  'trukk': trukkImage,
  'csoportos-alap': alapImage,
  'csoportos-kolyok': alapImage,
};

const allCourses = await getCollection('courses');
const testimonials = await getCollection('testimonials');
const siteInfo = await getEntry('site-info', 'main');
const pricingData = await getEntry('pricing', 'tiers');

// Sort by order and take first 3 for homepage
const sortedCourses = allCourses.sort((a, b) => a.data.order - b.data.order);
const featuredCourses = sortedCourses.slice(0, 3);
const sortedTestimonials = testimonials.sort((a, b) => a.data.order - b.data.order);
const pricingTiers = pricingData.data.sort((a, b) => a.order - b.order);
---

<Layout title="Kutyakiképzés pozitív megerősítéssel">
  <Header
    email={siteInfo.data.email}
    phone={siteInfo.data.phone}

  />

  <main>
    <Hero />

    <section class="courses" id="kurzusok">
      <div class="container">
        <h2 class="section-title">Kurzusok, amiken részt vehetsz</h2>

        <div class="courses-list">
          {featuredCourses.map((course, index) => (
            <CourseCard
              title={course.data.title}
              subtitle={course.data.subtitle}
              description={course.data.description}
              image={courseImages[course.id]}
              href={`/kurzusok/${course.id}`}
              reversed={index % 2 !== 0}
              highlighted={course.id === 'alap'}
            />
          ))}
          <CourseCard
            title="Happy Brain"
            subtitle="Szolgáltatás"
            description="Az alapkurzus után sem maradsz egyedül. Támogató lehetőségekkel segítem a megszerzett tudás fenntartását."
            image={happybrainImage}
            href="/kurzusok/happy-brain"
            reversed={featuredCourses.length % 2 !== 0}
          />
        </div>

      </div>
    </section>

    <section class="methodology" id="modszer">
      <div class="container">
        <h2 class="section-title">{siteInfo.data.methodology.title}</h2>
        <div class="methodology-content">
          <div class="methodology-text">
            <p>A tréning a <a href="https://lathatatlanporaz.hu/" target="_blank" rel="noopener noreferrer" class="methodology-link"><strong>Láthatatlan Póráz Módszer & Program</strong></a> tematikájára épül, mely teljes mértékben erőszakmentes. Csak pozitív megerősítéssel dolgozunk és kapcsolat fókuszú.</p>

            <p class="quote"><em>A "Láthatatlan póráz" program arról szól, hogy kutyánkat elsősorban szavainkkal, mozdulatainkkal tudjuk irányítani, ne a pórázt rángatva húzzuk, vonjuk őt, ne kelljen kiabálnunk vele. Ehhez elengedhetetlenül fontos, hogy tanuljunk kutyául, megértsük, a kutyánknak mi a fontos és elfogadjuk, hogy a változáshoz előbb változtatnunk kell.</em><br/>(Dömötör Júlia- a Láthatatlan Póráz Módszer alapítója)</p>

            <p>A tréning során egy kidolgozott, fix tematika szerint haladunk, emiatt a feladatok (pl: ül, fekszik, behívás, kapukontroll) időben nem cserélhetők fel és nem is hagyhatók el. Minden feladat lépcsőzetesen van felépítve, megkönnyítve így a tanulást és a gyakorlást. Ahogy haladunk előre, úgy épül szépen az a bizonyos láthatatlan póráz, mely gyakorlatilag a gazdi-kutyus kölcsönös bizalma.</p>

            <p><strong>FONTOS!</strong> Ez a módszer nem tünetet kezel és nem egy dologra/problémára fókuszál, így az alkalmak során nem engedelmességet, hanem együttműködést tanítunk. Egy olyan keretet, amely működtetésével sokszor magától megoldódnak korábbi problémák anélkül, hogy kimondottan azzal foglalkoztunk volna.</p>

          </div>
          <div class="methodology-image">
            <Image
              src={methodologyImage}
              alt="Láthatatlan Póráz módszer"
              width={1500}
              height={1000}
              quality={90}
              loading="lazy"
            />
            <Image
              src={fokepImage}
              alt="DOGSMILE kutyaoktatás"
              width={1500}
              height={1000}
              quality={90}
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="testimonials" id="velemenyek">
      <div class="container">
        <h2 class="section-title">Vélemények a kurzusokról</h2>


        <div class="testimonials-carousel">
          <button class="carousel-btn carousel-btn-prev" aria-label="Előző vélemény" data-dir="-1">&#8249;</button>
          <div class="testimonials-track-wrapper">
            <div class="testimonials-track">
              {sortedTestimonials.map((testimonial) => (
                <div class="testimonial-slide">
                  <Testimonial
                    name={testimonial.data.name}
                    quote={testimonial.data.quote}
                    image={testimonial.data.image}
                  />
                </div>
              ))}
            </div>
          </div>
          <button class="carousel-btn carousel-btn-next" aria-label="Következő vélemény" data-dir="1">&#8250;</button>
        </div>

        <div class="carousel-dots"></div>

        <div class="pride-wall-link">
          <a href="/buszkeseg">Nézd meg a Büszkeségfalat &rarr;</a>
        </div>
      </div>
    </section>
  </main>

  <Footer
    email={siteInfo.data.email}
    phone={siteInfo.data.phone}

  />
</Layout>

<style>
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  section {
    padding: 5rem 0;
  }

  .section-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--color-primary);
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-light);
    margin-bottom: 3rem;
  }

  /* Courses Section */
  .courses {
    background: white;
  }

  .courses-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .all-courses-link {
    text-align: center;
    margin-top: 2rem;
    color: var(--color-text-light);
  }

  .all-courses-link a {
    color: var(--color-primary);
    font-weight: 500;
  }

  .all-courses-link a:hover {
    text-decoration: underline;
  }

  /* Methodology Section */
  .methodology-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .methodology {
    background: var(--color-secondary);
  }

  .methodology-text p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
    text-align: justify;
    text-align-last: left;
  }

  .methodology-text .quote {
    font-style: italic;
  }

  .methodology-link {
    color: var(--color-primary);
    text-decoration: none;
  }

  .methodology-link:hover {
    color: var(--color-primary-dark);
  }

  .learn-more {
    color: var(--color-primary);
    font-weight: 600;
    transition: color 0.2s;
  }

  .learn-more:hover {
    color: var(--color-accent);
  }

  .methodology-image {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .methodology-image :global(img) {
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    width: 100%;
    height: auto;
  }

  /* Testimonials Section */
  .testimonials {
    background: white;
  }

  .testimonials-carousel {
    display: flex;
    align-items: center;
    gap: 1rem;
    position: relative;
  }

  .testimonials-track-wrapper {
    overflow: hidden;
    flex: 1;
  }

  .testimonials-track {
    display: flex;
    align-items: flex-start;
    transition: transform 0.4s ease;
  }

  .testimonial-slide {
    min-width: 100%;
    padding: 0 0.5rem;
    box-sizing: border-box;
  }

  .carousel-btn {
    background: var(--color-primary);
    color: white;
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.2s, transform 0.2s;
    line-height: 1;
  }

  .carousel-btn:hover {
    background: var(--color-primary-dark, #2a5a3a);
    transform: scale(1.1);
  }

  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .carousel-dots :global(.carousel-dot) {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--color-primary);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s;
  }

  .carousel-dots :global(.carousel-dot.active) {
    background: var(--color-primary);
  }

  .pride-wall-link {
    text-align: center;
    margin-top: 2rem;
  }

  .pride-wall-link a {
    color: var(--color-primary);
    font-weight: 600;
    transition: color 0.2s;
  }

  .pride-wall-link a:hover {
    color: var(--color-accent);
  }

  @media (min-width: 769px) {
    .testimonial-slide {
      min-width: 33.333%;
    }
  }

  @media (max-width: 768px) {
    .carousel-btn {
      width: 36px;
      height: 36px;
      font-size: 1.2rem;
    }
  }

  @media (max-width: 768px) {
    .methodology-content {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const track = document.querySelector('.testimonials-track') as HTMLElement;
  const slides = document.querySelectorAll('.testimonial-slide');
  const dotsContainer = document.querySelector('.carousel-dots') as HTMLElement;
  const btnPrev = document.querySelector('.carousel-btn-prev') as HTMLButtonElement;
  const btnNext = document.querySelector('.carousel-btn-next') as HTMLButtonElement;

  if (track && slides.length > 0) {
    let currentIndex = 0;

    function getSlidesPerView() {
      return window.innerWidth > 768 ? 3 : 1;
    }

    function getMaxIndex() {
      return Math.max(0, slides.length - getSlidesPerView());
    }

    function buildDots() {
      dotsContainer.innerHTML = '';
      const count = getMaxIndex() + 1;
      for (let i = 0; i < count; i++) {
        const dot = document.createElement('button');
        dot.className = `carousel-dot${i === currentIndex ? ' active' : ''}`;
        dot.setAttribute('aria-label', `Vélemény ${i + 1}`);
        dot.addEventListener('click', () => goTo(i));
        dotsContainer.appendChild(dot);
      }
    }

    function updateCarousel() {
      const slideWidth = 100 / getSlidesPerView();
      track.style.transform = `translateX(-${currentIndex * slideWidth}%)`;

      dotsContainer.querySelectorAll('.carousel-dot').forEach((dot, i) => {
        dot.classList.toggle('active', i === currentIndex);
      });
    }

    function goTo(index: number) {
      currentIndex = Math.max(0, Math.min(index, getMaxIndex()));
      updateCarousel();
    }

    btnPrev?.addEventListener('click', () => goTo(currentIndex - 1));
    btnNext?.addEventListener('click', () => goTo(currentIndex + 1));

    // Swipe support
    let startX = 0;
    let isDragging = false;
    const wrapper = document.querySelector('.testimonials-track-wrapper') as HTMLElement;

    wrapper?.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      isDragging = true;
    }, { passive: true });

    wrapper?.addEventListener('touchend', (e) => {
      if (!isDragging) return;
      isDragging = false;
      const diff = startX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        goTo(currentIndex + (diff > 0 ? 1 : -1));
      }
    });

    window.addEventListener('resize', () => {
      if (currentIndex > getMaxIndex()) {
        currentIndex = getMaxIndex();
      }
      buildDots();
      updateCarousel();
    });

    buildDots();
  }
</script>
