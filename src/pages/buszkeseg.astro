---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const siteInfo = await getEntry('site-info', 'main');
const graduatesData = await getEntry('graduates', 'all');
const graduates = graduatesData.data;
---

<Layout title="Büszkeség Fal" description="Gazdik és kutyáik, akik sikeresen elvégezték a DOGSMILE kurzusokat">
  <Header
    email={siteInfo.data.email}
    phone={siteInfo.data.phone}
    instagram={siteInfo.data.instagram}
  />

  <main class="pride-wall">
    <div class="container">
      <header class="page-header">
        <h1>Büszkeség Fal</h1>
        <p>Gazdik és kutyáik, akik sikeresen elvégezték kurzusainkat</p>
      </header>

      <div class="graduates-grid">
        {graduates.map((grad) => (
          <div class={`graduate-card ${grad.image ? 'has-image' : ''}`}>
            {grad.image ? (
              <div class="graduate-image">
                <img src={grad.image} alt={`${grad.dogName} és ${grad.ownerName}`} loading="lazy" />
              </div>
            ) : (
              <div class="graduate-avatar">
                <span>{grad.dogName.charAt(0)}</span>
              </div>
            )}
            <div class="graduate-info">
              <h3>{grad.dogName}</h3>
              <p class="owner">Gazdi: {grad.ownerName}</p>
              {grad.course && <span class="course-badge">{grad.course}</span>}
            </div>
          </div>
        ))}
      </div>

      <div class="cta-section">
        <h2>Szeretnéd, ha ti is itt lennétek?</h2>
        <p>Jelentkezz kurzusainkra és legyél te is a büszkeség falunk része!</p>
        <a href="/#kurzusok" class="cta-button">Kurzusok megtekintése</a>
      </div>
    </div>
  </main>

  <Footer
    email={siteInfo.data.email}
    phone={siteInfo.data.phone}
    instagram={siteInfo.data.instagram}
  />
</Layout>

<style>
  .pride-wall {
    padding-top: 10rem;
    padding-bottom: 4rem;
    background: var(--color-secondary);
    min-height: 100vh;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .page-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .page-header p {
    color: var(--color-text-light);
    font-size: 1.15rem;
  }

  .graduates-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
    margin-bottom: 4rem;
  }

  .graduate-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: white;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .graduate-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .graduate-avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--color-primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 600;
    flex-shrink: 0;
  }

  .graduate-image {
    width: 70px;
    height: 70px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .graduate-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .graduate-card.has-image {
    padding: 0.75rem;
  }

  .graduate-info h3 {
    color: var(--color-primary);
    margin-bottom: 0.15rem;
    font-size: 1rem;
  }

  .owner {
    color: var(--color-text-light);
    font-size: 0.85rem;
    margin: 0;
  }

  .course-badge {
    display: inline-block;
    background: var(--color-secondary);
    color: var(--color-primary);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 500;
    margin-top: 0.25rem;
  }

  .cta-section {
    text-align: center;
    background: white;
    padding: 3rem;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }

  .cta-section h2 {
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .cta-section p {
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
  }

  .cta-button {
    display: inline-block;
    background: var(--color-primary);
    color: white;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    transition: background 0.2s;
  }

  .cta-button:hover {
    background: var(--color-primary-dark);
  }
</style>
