---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';

const siteInfo = await getEntry('site-info', 'main');
const graduatesData = await getEntry('graduates', 'all');
const graduates = graduatesData.data;

// Import all graduate images
const graduateImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/graduates/*.{jpeg,jpg,png,gif}',
  { eager: true }
);

// Create a map of filename to image
const imageMap: Record<string, ImageMetadata> = {};
for (const [path, module] of Object.entries(graduateImages)) {
  const filename = path.split('/').pop()!;
  imageMap[filename] = module.default;
}
---

<Layout title="Büszkeség Fal" description="Gazdik és kutyáik, akik sikeresen elvégezték a DOGSMILE kurzusokat">
  <Header
    email={siteInfo.data.email}
    phone={siteInfo.data.phone}
    instagram={siteInfo.data.instagram}
  />

  <main class="pride-wall">
    <div class="container">
      <header class="page-header">
        <h1>Büszkeség Fal</h1>
        <p>Gazdik és kutyáik, akik sikeresen elvégezték kurzusainkat</p>
      </header>

      <div class="page-content">
        <div class="main-content">
          <div class="graduates-grid">
            {graduates.map((grad) => {
              const gradImage = grad.image ? imageMap[grad.image] : null;
              return (
                <div class={`graduate-card ${gradImage ? 'has-image' : ''}`}>
                  {gradImage ? (
                    <div class="graduate-image">
                      <Image src={gradImage} alt={`${grad.dogName} és ${grad.ownerName}`} width={70} height={70} />
                    </div>
                  ) : (
                    <div class="graduate-avatar">
                      <span>{grad.dogName.charAt(0)}</span>
                    </div>
                  )}
                  <div class="graduate-info">
                    <h3>{grad.dogName}</h3>
                    <p class="owner">Gazdi: {grad.ownerName}</p>
                    {grad.course && <span class="course-badge">{grad.course}</span>}
                  </div>
                </div>
              );
            })}
          </div>

          <div class="cta-section">
            <h2>Szeretnéd, ha ti is itt lennétek?</h2>
            <p>Jelentkezz kurzusainkra és legyél te is a büszkeség falunk része!</p>
            <a href="/jelentkezes" class="cta-button">Jelentkezem &raquo;</a>
          </div>
        </div>

        <Sidebar
          email={siteInfo.data.email}
          phone={siteInfo.data.phone}
          instagram={siteInfo.data.instagram}
        />
      </div>
    </div>
  </main>

  <Footer
    email={siteInfo.data.email}
    phone={siteInfo.data.phone}
    instagram={siteInfo.data.instagram}
  />
</Layout>

<style>
  .pride-wall {
    padding-top: 10rem;
    padding-bottom: 4rem;
    background: var(--color-secondary);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .page-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .page-header p {
    color: var(--color-text-light);
    font-size: 1.15rem;
  }

  .page-content {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3rem;
    align-items: start;
  }

  .graduates-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .graduate-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: white;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .graduate-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .graduate-avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--color-primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 600;
    flex-shrink: 0;
  }

  .graduate-image {
    width: 70px;
    height: 70px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .graduate-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .graduate-card.has-image {
    padding: 0.75rem;
  }

  .graduate-info h3 {
    color: var(--color-primary);
    margin-bottom: 0.15rem;
    font-size: 1rem;
  }

  .owner {
    color: var(--color-text-light);
    font-size: 0.85rem;
    margin: 0;
  }

  .course-badge {
    display: inline-block;
    background: var(--color-secondary);
    color: var(--color-primary);
    padding: 0.15rem 0.5rem;
    border-radius: 8px;
    font-size: 0.7rem;
    font-weight: 500;
    margin-top: 0.25rem;
  }

  .cta-section {
    text-align: center;
    background: white;
    padding: 2rem;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }

  .cta-section h2 {
    color: var(--color-primary);
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
  }

  .cta-section p {
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
  }

  .cta-button {
    display: inline-block;
    background: var(--color-primary);
    color: white;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    transition: background 0.2s;
  }

  .cta-button:hover {
    background: var(--color-primary-dark);
  }

  @media (max-width: 968px) {
    .page-content {
      grid-template-columns: 1fr;
    }
  }
</style>
