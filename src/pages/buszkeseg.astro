---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';

const siteInfo = await getEntry('site-info', 'main');
const graduatesData = await getEntry('graduates', 'all');
const graduates = graduatesData.data;

// Split graduates: first batch next to sidebar, rest full-width below
const sidebarRows = 9;
const graduatesTop = graduates.slice(0, sidebarRows);
const graduatesBottom = graduates.slice(sidebarRows);

// Import all graduate images
const graduateImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/graduates/*.{jpeg,jpg,png,gif}',
  { eager: true }
);

// Create a map of filename to image
const imageMap: Record<string, ImageMetadata> = {};
for (const [path, module] of Object.entries(graduateImages)) {
  const filename = path.split('/').pop()!;
  imageMap[filename] = module.default;
}
---

<Layout title="Büszkeségfal" description="Gazdik és kutyáik, akik sikeresen elvégezték a DOGSMILE kurzusokat">
  <Header
    email={siteInfo.data.email}
    phone={siteInfo.data.phone}

  />

  <main class="pride-wall">
    <div class="container">
      <header class="page-header">
        <h1>Büszkeségfal</h1>
      </header>

      <div class="page-content">
        <div class="main-content">
          <div class="graduates-grid">
            {graduatesTop.map((grad) => {
              const gradImage = grad.image ? imageMap[grad.image] : null;
              return (
                <div class={`graduate-card ${gradImage ? 'has-image' : ''}`}>
                  <div class="graduate-info">
                    <h3>{grad.displayName || `${grad.ownerName} és ${grad.dogName}`}</h3>
                  </div>
                  {gradImage ? (
                    <div class="graduate-image">
                      <Image src={gradImage} alt={`${grad.dogName} és ${grad.ownerName}`} width={300} height={300} quality={90} />
                    </div>
                  ) : (
                    <div class="graduate-avatar">
                      <span>{grad.dogName.charAt(0)}</span>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </div>

        <Sidebar
          email={siteInfo.data.email}
          phone={siteInfo.data.phone}
        />
      </div>

      {graduatesBottom.length > 0 && (
        <div class="graduates-grid graduates-grid-full">
          {graduatesBottom.map((grad) => {
            const gradImage = grad.image ? imageMap[grad.image] : null;
            return (
              <div class={`graduate-card ${gradImage ? 'has-image' : ''}`}>
                <div class="graduate-info">
                  <h3>{grad.displayName || `${grad.ownerName} és ${grad.dogName}`}</h3>
                </div>
                {gradImage ? (
                  <div class="graduate-image">
                    <Image src={gradImage} alt={`${grad.dogName} és ${grad.ownerName}`} width={300} height={300} quality={90} />
                  </div>
                ) : (
                  <div class="graduate-avatar">
                    <span>{grad.dogName.charAt(0)}</span>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      )}

      <div class="cta-section">
        <h2>Szeretnéd, ha ti is itt lennétek?</h2>
        <p>Jelentkezz bátran és legyél te is a büszkeségfal része!</p>
        <a href="/jelentkezes" class="cta-button">Jelentkezem &raquo;</a>
      </div>
    </div>
  </main>

  <Footer
    email={siteInfo.data.email}
    phone={siteInfo.data.phone}

  />
</Layout>

<style>
  .pride-wall {
    padding-top: 10rem;
    padding-bottom: 4rem;
    background: var(--color-secondary);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .page-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .page-header p {
    color: var(--color-text-light);
    font-size: 1.15rem;
  }

  .page-content {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3rem;
    align-items: start;
  }

  .graduates-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .graduates-grid-full {
    grid-template-columns: repeat(4, 1fr);
    margin-top: 2rem;
  }

  .graduate-card {
    display: flex;
    flex-direction: column;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .graduate-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .graduate-info {
    padding: 0.5rem 0.75rem;
    text-align: center;
  }

  .graduate-avatar {
    width: 100%;
    aspect-ratio: 1;
    background: var(--color-primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 600;
  }

  .graduate-image {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .graduate-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .graduate-info h3 {
    color: var(--color-primary);
    font-family: 'Lexend Deca', sans-serif;
    font-size: 1.05rem;
    font-weight: 500;
  }

  .cta-section {
    text-align: center;
    background: white;
    padding: 2rem;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    max-width: 500px;
    margin: 2rem auto 0;
  }

  .cta-section h2 {
    color: var(--color-primary);
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
  }

  .cta-section p {
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
  }

  .cta-button {
    display: inline-block;
    background: var(--color-primary);
    color: white;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    transition: background 0.2s;
  }

  .cta-button:hover {
    background: var(--color-primary-dark);
  }

  @media (max-width: 968px) {
    .page-content {
      grid-template-columns: 1fr;
    }

    .graduates-grid-full {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    }
  }
</style>
